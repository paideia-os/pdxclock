// src/tool_ident.pdx — pdxclock v0.5.0
//
// ToolIdent module: PDX_TOOL_NAME literal, present for parity with the
// rest of the tools tree (see tools/user/mkdir/src/tool_ident.pdx in
// the paideia-os monorepo for the libpdx-argv >= 1.1.3 contract this
// mirrors) even though pdxclock does not link libpdx-argv at v0.5.0 --
// argv is parsed inline by src/argv.pdx. Declared now so a future
// `--version` / `--help` wire-in via libpdx-argv is a link-only change.
//
// paideia-as compliance: module basename PascalCase (`ToolIdent`);
// single-line string literal; array size == byte count including NUL
// ("pdxclock\0" = 9 bytes); `pub let` (immutable, .rodata).

module ToolIdent = structure {
  pub let PDX_TOOL_NAME : [u8; 9] = "pdxclock\0"
}
